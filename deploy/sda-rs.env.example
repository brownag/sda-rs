# Copy to /etc/sda-rs/sda-rs.env (root:root, 0644). Non-secret values only.
# Leave SDA_SPATIAL_EXTENSION unset until SpatiaLite is installed; non-spatial SQL
# works without it. Spatial queries fail with a structured error when it is unset.
#
# SDA_SPATIAL_EXTENSION=/usr/lib/x86_64-linux-gnu/mod_spatialite.so
# RUST_LOG=info
